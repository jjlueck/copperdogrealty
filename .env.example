# Copy to .env.local and fill in. On Vercel these are set in Project Settings.
# Values here are placeholders, not real credentials.

# --- MLS listing feed (RETS) ---
# Read by lib/rets-client.ts.
RETS_LOGIN_URL=https://rets.example.com/rets/login
RETS_USERNAME=your_rets_username
RETS_PASSWORD=your_rets_password

# Set RETS_FIXTURES=1 to serve the deterministic listings in lib/rets-fixtures.ts
# instead of calling the MLS. playwright.config.ts sets this for the e2e suite,
# which has no credentials in CI. Not intended for real deployments.
# RETS_FIXTURES=1

# --- Transactional email (Resend) ---
# Read by app/api/contact/route.ts and app/api/dog-photo/route.ts.
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL=noreply@copperdogrealty.com
RESEND_TO_EMAIL=info@copperdogrealty.com

# --- Photo uploads (Vercel Blob) ---
# Read by app/api/dog-photo/upload/route.ts for the /share-your-dog page.
# Vercel injects this automatically once a Blob store is connected to the
# project. For local development run: vercel env pull .env.local
# Point local development at a SEPARATE dev store, otherwise test uploads land
# permanently in the production store.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_your_token

# --- Google Maps ---
# Note: next.config.mjs exposes this to the client bundle, so it is public.
# Restrict it by HTTP referrer in the Google Cloud console.
GOOGLE_MAPS_API_KEY=your_maps_api_key

# --- On-demand revalidation ---
REVALIDATION_TOKEN=some_long_random_string
